        {
          "ruleId": "offer-in-native-currency",
          "ruleIndex": 17,
          "level": "error",
          "message": {
            "text": "Offer O1 is priced in ETH, the native currency of ethereum, which a marketplace cannot draw from the wallet of the buyer when a seller fills the offer; offers are paid in a wrapped token the buyer approved. This is a best practice of this tool, not a rule in the pages it cites. Fix: Price the offer in the wrapped token of the chain, such as WETH, and have the buyer approve it for the marketplace."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/orders.json",
