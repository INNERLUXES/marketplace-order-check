        {
          "ruleId": "start-after-end",
          "ruleIndex": 14,
          "level": "error",
          "message": {
            "text": "Order L3 starts at unix second 1800500000 and ends at 1800400000, so it is open for no second: it ends before it starts. This is a best practice of this tool, not a rule in the pages it cites. Fix: Set the end after the start; both are unix seconds."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
