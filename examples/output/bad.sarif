              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "subject": "O1"
          }
        },
        {
          "ruleId": "order-expired",
          "ruleIndex": 13,
          "level": "error",
          "message": {
            "text": "Order O1 ends at unix second 1799900000, 100,000 seconds before the second given with --now, 1800000000, so it can no longer be filled. This is a best practice of this tool, not a rule in the pages it cites. Fix: Give the order a later end and sign it again, or remove it from the file."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/orders.json",
                  "index": 0
